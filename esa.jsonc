{
  "installCommand": "sudo add-apt-repository ppa:deadsnakes/ppa -y && sudo apt update && sudo apt install python3.11 python3.11-venv python3.11-dev -y && python3.11 -m pip install --upgrade pip && python3.11 -m pip install uv && uv sync --index-url https://mirrors.aliyun.com/pypi/simple/ && chmod +x ./scripts/pre-build/install-theme.sh && ./scripts/pre-build/install-theme.sh",
  "buildCommand": "uv run mkdocs build -v",
  "assets": {
    "directory": "./site"
  }
}
